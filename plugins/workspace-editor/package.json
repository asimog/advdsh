{
  "name": "workspace-editor",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Workspace editor plugin: Euro-Office document editor in a right-sidebar tab, x2t open/save/PDF export, and an agent document_edit tool.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./engine": "./lib/engine/index.js",
    "./model": "./lib/model/index.js",
    "./tools": "./lib/tools/index.js",
    "./fanout": "./lib/fanout/index.js",
    "./review": "./lib/review/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/model/**",
    "lib/tools/**",
    "lib/fanout/**",
    "lib/review/**",
    "lib/x2t.js",
    "lib/docs.js",
    "lib/docs-edit.js",
    "lib/editor/host.html",
    "lib/editor/shim.js",
    "lib/editor/boot.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "lib/engine/**"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "verify:model": "node lib/model/verify.mjs"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "jszip": "3.10.1"
  }
}
